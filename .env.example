# انسخ هذا الملف باسم .env واملأ القيم من لوحة تحكم إضافة MySQL على Clever Cloud
DB_HOST=your-mysql-host.clever-cloud.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database_name

PORT=3000
FACILITY_ID=1

# مفتاح سري لتوقيع رموز الدخول (JWT) - غيّره لقيمة عشوائية طويلة عند النشر الفعلي
JWT_SECRET=change-this-to-a-long-random-string
